---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Artemis II — Live Mission Dashboard",
  description = "Track NASA's Artemis II lunar mission in real time. 3D trajectory, astronaut profiles, and live mission data.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[10000] focus:px-4 focus:py-2 focus:bg-accent-cyan focus:text-space-900 focus:font-bold focus:rounded focus:text-sm">
      Skip to content
    </a>
    <slot />
  </body>
</html>

<style>
  @import "../styles/global.css";
</style>
