---
/**
 * LunarPhotos — Placeholder section for far-side-of-the-Moon photographs.
 * Displays glass-styled cards ready to be swapped for real NASA imagery
 * after the lunar flyby.
 */

const photos = [
  {
    label: "Full Moon — Near & Far Side",
    caption: "April 6, 2026 — Fully illuminated view during flyby approach",
    src: "https://images-assets.nasa.gov/image/art002e009212/art002e009212~large.jpg",
    credit: "NASA / Artemis II Crew",
  },
  {
    label: "Orientale Basin Region",
    caption: "April 6, 2026 — Lunar surface near the Orientale impact basin",
    src: "https://www.nasa.gov/wp-content/uploads/2026/04/image.png?w=2048",
    credit: "NASA / Artemis II Crew",
  },
  {
    label: "Earthrise from Orion",
    caption: "April 6, 2026 — Earth rises above the lunar horizon, 252,000+ miles away",
    src: "https://www.nasa.gov/wp-content/uploads/2026/04/earthrise.jpg?w=766",
    credit: "NASA / Artemis II Crew",
  },
];
---

<section id="lunar-photos" class="px-6 py-28">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="mb-20">
      <p class="font-heading font-extrabold text-[11px] tracking-[0.35em] text-accent-gold uppercase mb-4">Lunar Imagery</p>
      <h2 class="font-display font-bold uppercase text-[clamp(2rem,6vw,5rem)] leading-[0.95] tracking-tight">
        Far Side<br />
        <span class="text-accent-gold">of the Moon</span>
      </h2>
      <p class="text-lunar-300 mt-4 text-base max-w-md">
        The crew of Artemis II photographed the lunar far side during their flyby -- views no human has seen in over 50 years.
      </p>
    </div>

    <!-- Photo grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {photos.map((photo) => (
        <div class="glass overflow-hidden group">
          <div class="relative aspect-[4/3] bg-space-800 overflow-hidden">
            <img
              src={photo.src}
              alt={photo.label}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
          </div>
          <div class="px-5 py-4 border-t border-glass-border">
            <p class="font-heading font-extrabold text-sm uppercase tracking-wide text-lunar-200">{photo.label}</p>
            <p class="mono text-[10px] text-lunar-300 mt-1 tracking-wider">{photo.caption}</p>
            <p class="mono text-[9px] text-lunar-400/60 mt-1">{photo.credit}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

