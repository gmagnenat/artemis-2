---
/**
 * SpaceScale — One cinematic statement about the distance.
 * Big typography, live numbers, no gimmicks.
 */
---

<div id="space-scale-section" class="py-20 px-6">
  <div class="max-w-5xl mx-auto text-center">
    <p class="font-display font-bold uppercase text-[clamp(1.5rem,4vw,3rem)] leading-[1.2] tracking-tight text-lunar-100">
      Right now, Orion is
      <span id="scale-distance" class="text-accent-cyan">---</span>
      from Earth.
    </p>
    <p class="font-display font-bold uppercase text-[clamp(1.5rem,4vw,3rem)] leading-[1.2] tracking-tight text-lunar-400 mt-2">
      A message would take
      <span id="scale-lighttime" class="text-accent-gold">---</span>
      to reach them.
    </p>
  </div>
</div>

<script>
  import { loadTrajectory, getDistancesAt, type TrajectoryData } from "../lib/trajectory";

  const distEl = document.getElementById("scale-distance")!;
  const lightEl = document.getElementById("scale-lighttime")!;

  let data: TrajectoryData | null = null;
  loadTrajectory().then((d) => { data = d; update(); });

  function update() {
    if (!data) return;
    const earthKm = Math.max(0, getDistancesAt(data.spacecraft, data.moon, new Date()).earth);

    if (earthKm >= 1_000) {
      distEl.textContent = `${Math.round(earthKm).toLocaleString("en-US")} km`;
    } else {
      distEl.textContent = `${earthKm.toFixed(0)} km`;
    }

    const lightSeconds = earthKm / 299_792;
    if (lightSeconds >= 1) {
      lightEl.textContent = `${lightSeconds.toFixed(1)} seconds`;
    } else {
      lightEl.textContent = `${(lightSeconds * 1000).toFixed(0)} milliseconds`;
    }
  }

  update();
  setInterval(update, 5000);
</script>
