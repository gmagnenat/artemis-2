---
/**
 * Circular SVG donut chart showing mission completion percentage.
 * Updates every second based on mission elapsed time vs total mission time.
 */
---

<div class="progress-ring-container">
  <svg
    id="progress-ring-svg"
    width="120"
    height="120"
    viewBox="0 0 120 120"
  >
    <!-- Background ring -->
    <circle
      cx="60"
      cy="60"
      r="52"
      fill="none"
      stroke="var(--color-space-600)"
      stroke-width="6"
    />
    <!-- Progress arc -->
    <circle
      id="progress-ring-arc"
      cx="60"
      cy="60"
      r="52"
      fill="none"
      stroke="var(--color-accent-cyan)"
      stroke-width="6"
      stroke-linecap="round"
      stroke-dasharray="0 326.73"
      transform="rotate(-90 60 60)"
    />
  </svg>
  <div class="progress-ring-label">
    <span id="progress-ring-pct" class="font-display text-lunar-100">0%</span>
    <span class="mono text-lunar-400 progress-ring-sub">COMPLETE</span>
  </div>
</div>

<style>
  .progress-ring-container {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .progress-ring-label {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  #progress-ring-pct {
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
  }

  .progress-ring-sub {
    font-size: 8px;
    letter-spacing: 0.2em;
    margin-top: 2px;
  }

  #progress-ring-arc {
    transition: stroke-dasharray 0.4s ease;
  }
</style>

<script>
  import { MISSION, getMissionElapsedTime } from "../lib/mission";

  const arc = document.getElementById("progress-ring-arc") as SVGCircleElement | null;
  const pctEl = document.getElementById("progress-ring-pct");

  const RADIUS = 52;
  const CIRCUMFERENCE = 2 * Math.PI * RADIUS; // ~326.73

  const totalMissionSeconds =
    (MISSION.splashdownTime.getTime() - MISSION.launchTime.getTime()) / 1000;

  function update() {
    const met = getMissionElapsedTime();
    const pct = Math.min(100, Math.max(0, (met / totalMissionSeconds) * 100));
    const filled = (pct / 100) * CIRCUMFERENCE;

    if (arc) {
      arc.setAttribute("stroke-dasharray", `${filled} ${CIRCUMFERENCE - filled}`);
    }
    if (pctEl) {
      pctEl.textContent = `${Math.round(pct)}%`;
    }
  }

  update();
  setInterval(update, 1000);
</script>
