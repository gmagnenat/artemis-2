---
/**
 * TrajectoryScene — Three.js trajectory with the hand-crafted free-return
 * shape from our SVG, lifted into 3D with Z-depth for interactivity.
 * Falls back to a static SVG on mobile (< 768px) or no WebGL.
 */
---

<!-- Mobile / no-WebGL fallback (same SVG as before, simplified) -->
<div id="trajectory-fallback" class="hidden w-full">
  <svg viewBox="0 0 1000 520" class="w-full h-auto" xmlns="http://www.w3.org/2000/svg">
    <rect width="1000" height="520" fill="#04060b" rx="12" />
    <g fill="white" opacity="0.3">
      <circle cx="80" cy="40" r="1" /><circle cx="200" cy="80" r="0.8" />
      <circle cx="400" cy="50" r="1.1" /><circle cx="600" cy="30" r="0.7" />
      <circle cx="800" cy="70" r="1" /><circle cx="150" cy="400" r="0.9" />
      <circle cx="500" cy="450" r="0.8" /><circle cx="900" cy="420" r="1" />
    </g>
    <path d="M 140 260 C 250 160,450 100,650 130 C 750 145,820 180,850 230 C 875 270,875 290,850 320 C 820 370,750 400,650 390 C 450 370,250 340,140 260" fill="none" stroke="#06b6d4" stroke-width="1.5" opacity="0.5" />
    <circle cx="140" cy="260" r="18" fill="#0f2847" stroke="#3b82f6" stroke-width="1.5" />
    <text x="140" y="295" text-anchor="middle" fill="#64748b" font-size="13" font-family="sans-serif">Earth</text>
    <circle cx="830" cy="275" r="8" fill="#3a3a40" stroke="#94a3b8" stroke-width="1" />
    <text x="830" y="300" text-anchor="middle" fill="#64748b" font-size="13" font-family="sans-serif">Moon</text>
    <circle cx="500" cy="120" r="5" fill="#f59e0b" opacity="0.9">
      <animate attributeName="opacity" values="0.9;0.5;0.9" dur="2s" repeatCount="indefinite" />
    </circle>
    <text x="500" y="110" text-anchor="middle" fill="#f59e0b" font-size="10" font-family="monospace">ORION</text>
  </svg>
</div>

<!-- 3D Canvas -->
<div id="trajectory-canvas" class="relative w-full aspect-[2/1] max-h-[600px] rounded-xl overflow-hidden">
  <canvas id="trajectory-gl" class="w-full h-full block"></canvas>
  <div id="trajectory-loading" class="absolute inset-0 flex items-center justify-center bg-space-900/80 backdrop-blur-sm transition-opacity duration-500">
    <div class="text-center">
      <div class="inline-block w-8 h-8 border-2 border-accent-cyan/30 border-t-accent-cyan rounded-full animate-spin mb-3"></div>
      <p class="mono text-xs text-lunar-400">Initializing trajectory...</p>
    </div>
  </div>
  <!-- Distance readout overlay -->
  <div class="absolute bottom-3 left-4 mono text-xs text-accent-blue/60" id="dist-readout"></div>
  <!-- Drag hint -->
  <div id="drag-hint" class="absolute bottom-3 right-4 mono text-[10px] text-lunar-400/40 transition-opacity duration-1000">drag to rotate</div>
</div>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { MISSION } from "@/lib/mission";

  // -----------------------------------------------------------------------
  // Detection
  // -----------------------------------------------------------------------

  function isWebGLAvailable(): boolean {
    try {
      const c = document.createElement("canvas");
      return !!(window.WebGLRenderingContext && (c.getContext("webgl") || c.getContext("experimental-webgl")));
    } catch { return false; }
  }

  const isMobile = window.innerWidth < 768;
  const fallback = document.getElementById("trajectory-fallback")!;
  const canvasWrap = document.getElementById("trajectory-canvas")!;

  if (isMobile || !isWebGLAvailable()) {
    fallback.classList.remove("hidden");
    canvasWrap.classList.add("hidden");
  } else {
    fallback.classList.add("hidden");
    canvasWrap.classList.remove("hidden");
    initScene();
  }

  // -----------------------------------------------------------------------
  // Three.js Scene
  // -----------------------------------------------------------------------

  function initScene() {
    const canvas = document.getElementById("trajectory-gl") as HTMLCanvasElement;
    const loadingEl = document.getElementById("trajectory-loading")!;
    const distReadout = document.getElementById("dist-readout")!;
    const dragHint = document.getElementById("drag-hint")!;

    // Renderer
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.1;

    // Scene
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x04060b);

    // Camera
    const aspect = canvas.clientWidth / canvas.clientHeight;
    const camera = new THREE.PerspectiveCamera(50, aspect, 0.1, 2000);
    camera.position.set(0, 100, 180);

    // Controls
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.minDistance = 40;
    controls.maxDistance = 400;
    controls.enablePan = false;
    controls.target.set(50, 0, 0);

    // Hide drag hint after first interaction
    controls.addEventListener("start", () => {
      dragHint.style.opacity = "0";
    });

    // Lighting
    scene.add(new THREE.AmbientLight(0x1a2236, 0.5));
    const sun = new THREE.DirectionalLight(0xfff5e6, 1.8);
    sun.position.set(200, 60, 100);
    scene.add(sun);
    const fill = new THREE.DirectionalLight(0x3b82f6, 0.12);
    fill.position.set(-100, -30, -50);
    scene.add(fill);

    // -------------------------------------------------------------------
    // Stars
    // -------------------------------------------------------------------
    const starCount = 1500;
    const starPos = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      const r = 350 + Math.random() * 500;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      starPos[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      starPos[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
      starPos[i * 3 + 2] = r * Math.cos(phi);
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute("position", new THREE.BufferAttribute(starPos, 3));
    scene.add(new THREE.Points(starGeo, new THREE.PointsMaterial({
      color: 0xffffff, size: 0.5, sizeAttenuation: true, transparent: true, opacity: 0.7,
    })));

    // -------------------------------------------------------------------
    // Earth (at origin)
    // -------------------------------------------------------------------
    const earthGeo = new THREE.IcosahedronGeometry(10, 3);
    const earthMat = new THREE.MeshStandardMaterial({
      color: 0x1e4a7a, roughness: 0.7, metalness: 0.1, flatShading: true,
    });
    const earth = new THREE.Mesh(earthGeo, earthMat);
    scene.add(earth);
    earth.add(makeGlow(0x3b82f6, 35, 0.1));

    // -------------------------------------------------------------------
    // Moon
    // -------------------------------------------------------------------
    const MOON_DIST = 120; // scene units from Earth
    const moonGeo = new THREE.IcosahedronGeometry(3, 2);
    const moonMat = new THREE.MeshStandardMaterial({
      color: 0x8a8a8f, roughness: 0.9, metalness: 0.05, flatShading: true,
    });
    const moon = new THREE.Mesh(moonGeo, moonMat);
    moon.position.set(MOON_DIST, 0, 0);
    scene.add(moon);
    moon.add(makeGlow(0x94a3b8, 12, 0.07));

    // -------------------------------------------------------------------
    // Trajectory curve
    //
    // Map the SVG bezier shape into 3D:
    // SVG: Earth at (140, 260), Moon at (830, 275), viewBox 1000x520
    // 3D:  Earth at (0,0,0), Moon at (MOON_DIST, 0, 0)
    //
    // Scale: (830-140) SVG units = MOON_DIST scene units
    // Add Z variation for the out-of-plane component (~10% of scale)
    // -------------------------------------------------------------------

    const SVG_EX = 140, SVG_EY = 260;
    const SVG_MX = 830;
    const svgScale = MOON_DIST / (SVG_MX - SVG_EX);

    // Convert SVG (x, y) → scene (x, y_scene, z) where:
    //   x_scene = (svgX - SVG_EX) * scale
    //   y_scene = -(svgY - SVG_EY) * scale  (flip Y)
    //   z = slight out-of-plane variation
    function svgTo3D(sx: number, sy: number, z: number = 0): THREE.Vector3 {
      return new THREE.Vector3(
        (sx - SVG_EX) * svgScale,
        -(sy - SVG_EY) * svgScale,
        z,
      );
    }

    // SVG bezier: M 140 260 C 250 160,450 100,650 130 C 750 145,820 180,850 230
    //             C 875 270,875 290,850 320 C 820 370,750 400,650 390
    //             C 450 370,250 340,140 260
    //
    // We sample the cubic beziers as control points, adding Z for depth.

    const curvePoints = [
      svgTo3D(140, 260, 0),        // Earth departure
      svgTo3D(195, 210, 5),
      svgTo3D(250, 160, 10),       // CP
      svgTo3D(350, 120, 14),
      svgTo3D(450, 100, 16),       // CP
      svgTo3D(550, 110, 14),
      svgTo3D(650, 130, 10),       // CP
      svgTo3D(700, 138, 6),
      svgTo3D(750, 145, 2),        // CP
      svgTo3D(785, 162, -2),
      svgTo3D(820, 180, -5),       // CP - approaching Moon
      svgTo3D(840, 210, -8),
      svgTo3D(850, 230, -10),      // near Moon
      svgTo3D(865, 255, -12),
      svgTo3D(875, 270, -13),      // behind Moon (closest approach)
      svgTo3D(875, 290, -12),
      svgTo3D(860, 310, -10),      // exiting flyby
      svgTo3D(850, 320, -8),
      svgTo3D(835, 345, -5),
      svgTo3D(820, 370, -2),       // CP
      svgTo3D(785, 385, 0),
      svgTo3D(750, 400, 2),        // CP
      svgTo3D(700, 395, 4),
      svgTo3D(650, 390, 6),        // CP
      svgTo3D(550, 382, 8),
      svgTo3D(450, 370, 8),        // CP
      svgTo3D(350, 355, 6),
      svgTo3D(250, 340, 4),        // CP
      svgTo3D(195, 300, 2),
      svgTo3D(140, 260, 0),        // back to Earth
    ];

    const trajCurve = new THREE.CatmullRomCurve3(curvePoints, false, "catmullrom", 0.3);
    const trajPoints = trajCurve.getPoints(400);

    // Trajectory line
    const lineGeo = new THREE.BufferGeometry().setFromPoints(trajPoints);
    const lineMat = new THREE.LineBasicMaterial({
      color: 0x06b6d4, transparent: true, opacity: 0.35,
    });
    scene.add(new THREE.Line(lineGeo, lineMat));

    // Glow line
    scene.add(new THREE.Line(
      lineGeo.clone(),
      new THREE.LineBasicMaterial({ color: 0x06b6d4, transparent: true, opacity: 0.08, linewidth: 1 }),
    ));

    // Completed portion line (updated each frame)
    const completedGeo = new THREE.BufferGeometry();
    const completedLine = new THREE.Line(completedGeo, new THREE.LineBasicMaterial({
      color: 0x06b6d4, transparent: true, opacity: 0.7,
    }));
    scene.add(completedLine);

    // -------------------------------------------------------------------
    // Orion
    // -------------------------------------------------------------------
    const orionGeo = new THREE.SphereGeometry(1.2, 16, 16);
    const orionMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
    const orion = new THREE.Mesh(orionGeo, orionMat);
    scene.add(orion);
    orion.add(makeGlow(0xf59e0b, 8, 0.35));
    const orionPulse = makeGlow(0xf59e0b, 14, 0.12);
    orion.add(orionPulse);

    // -------------------------------------------------------------------
    // Distance dashed line Earth → Orion
    // -------------------------------------------------------------------
    const dashGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
    const dashMat = new THREE.LineDashedMaterial({
      color: 0x3b82f6, dashSize: 2, gapSize: 2, transparent: true, opacity: 0.15,
    });
    const dashLine = new THREE.Line(dashGeo, dashMat);
    dashLine.computeLineDistances();
    scene.add(dashLine);

    // -------------------------------------------------------------------
    // Mission progress
    // -------------------------------------------------------------------
    const launchMs = MISSION.launchTime.getTime();
    const splashMs = MISSION.splashdownTime.getTime();
    const totalMs = splashMs - launchMs;

    // Distance milestones: progress → km from Earth
    const distMilestones: [number, number][] = [
      [0, 185], [0.05, 2200], [0.10, 70000], [0.15, 50000],
      [0.20, 100000], [0.30, 200000], [0.40, 300000], [0.50, 380000],
      [0.55, 413146], [0.60, 390000], [0.70, 300000], [0.80, 200000],
      [0.90, 100000], [0.95, 30000], [1, 0],
    ];

    function getDistKm(p: number): number {
      for (let i = 0; i < distMilestones.length - 1; i++) {
        const [p0, d0] = distMilestones[i];
        const [p1, d1] = distMilestones[i + 1];
        if (p >= p0 && p <= p1) return d0 + ((p - p0) / (p1 - p0)) * (d1 - d0);
      }
      return 0;
    }

    function getProgress(): number {
      const now = Date.now();
      if (now <= launchMs) return 0;
      if (now >= splashMs) return 1;
      return (now - launchMs) / totalMs;
    }

    // -------------------------------------------------------------------
    // Animation
    // -------------------------------------------------------------------
    const clock = new THREE.Clock();
    const frameInterval = 1 / 30;
    let elapsed = 0;
    let animId: number;

    function animate() {
      animId = requestAnimationFrame(animate);
      elapsed += clock.getDelta();
      if (elapsed < frameInterval) return;
      elapsed %= frameInterval;

      // Earth rotation
      earth.rotation.y += 0.002;

      // Orion position
      const progress = getProgress();
      const t = Math.max(0, Math.min(0.999, progress));
      const pos = trajCurve.getPointAt(t);
      orion.position.copy(pos);

      // Pulse
      const pulse = 0.3 + 0.1 * Math.sin(Date.now() * 0.003);
      (orionPulse.material as THREE.SpriteMaterial).opacity = pulse * 0.4;

      // Completed path
      const completedIdx = Math.ceil(t * 400);
      if (completedIdx > 1) {
        const pts = trajPoints.slice(0, completedIdx + 1);
        completedLine.geometry.dispose();
        completedLine.geometry = new THREE.BufferGeometry().setFromPoints(pts);
      }

      // Dashed line Earth → Orion
      const dashPositions = dashLine.geometry.attributes.position;
      if (dashPositions) {
        dashPositions.setXYZ(0, 0, 0, 0);
        dashPositions.setXYZ(1, pos.x, pos.y, pos.z);
        dashPositions.needsUpdate = true;
        dashLine.computeLineDistances();
      }

      // Distance readout
      const km = getDistKm(progress);
      if (km >= 1000) {
        distReadout.textContent = `${(km / 1000).toFixed(1)}K km from Earth`;
      } else {
        distReadout.textContent = `${km.toFixed(0)} km from Earth`;
      }

      controls.update();
      renderer.render(scene, camera);
    }

    animate();

    // Hide loading
    requestAnimationFrame(() => {
      loadingEl.style.opacity = "0";
      setTimeout(() => loadingEl.remove(), 500);
    });

    // Resize
    const ro = new ResizeObserver(() => {
      const w = canvasWrap.clientWidth;
      const h = canvasWrap.clientHeight;
      if (w === 0 || h === 0) return;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    });
    ro.observe(canvasWrap);

    // Switch to fallback on resize to mobile
    window.addEventListener("resize", () => {
      if (window.innerWidth < 768) {
        fallback.classList.remove("hidden");
        canvasWrap.classList.add("hidden");
        cleanup();
      }
    });

    function cleanup() {
      cancelAnimationFrame(animId);
      ro.disconnect();
      controls.dispose();
      renderer.dispose();
      scene.traverse((obj) => {
        if (obj instanceof THREE.Mesh || obj instanceof THREE.Line || obj instanceof THREE.Points) {
          obj.geometry.dispose();
          const mats = Array.isArray(obj.material) ? obj.material : [obj.material];
          mats.forEach((m) => m.dispose());
        }
        if (obj instanceof THREE.Sprite) {
          obj.material.map?.dispose();
          obj.material.dispose();
        }
      });
    }

    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  // -----------------------------------------------------------------------
  // Glow sprite helper
  // -----------------------------------------------------------------------
  function makeGlow(color: number, size: number, opacity: number): THREE.Sprite {
    const c = document.createElement("canvas");
    c.width = 128; c.height = 128;
    const ctx = c.getContext("2d")!;
    const grad = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    const col = new THREE.Color(color);
    const rgb = `${Math.floor(col.r * 255)},${Math.floor(col.g * 255)},${Math.floor(col.b * 255)}`;
    grad.addColorStop(0, `rgba(${rgb},1)`);
    grad.addColorStop(0.4, `rgba(${rgb},0.3)`);
    grad.addColorStop(1, `rgba(${rgb},0)`);
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, 128, 128);
    const tex = new THREE.CanvasTexture(c);
    const mat = new THREE.SpriteMaterial({
      map: tex, transparent: true, opacity, blending: THREE.AdditiveBlending, depthWrite: false,
    });
    const sprite = new THREE.Sprite(mat);
    sprite.scale.set(size, size, 1);
    return sprite;
  }
</script>
