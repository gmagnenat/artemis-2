---
import type { Astronaut } from "../lib/astronauts";

interface Props {
  astronaut: Astronaut;
  index: number;
}

const { astronaut, index } = Astro.props;
---

<div class="card-container" data-card-index={index}>
  <div class="card-inner">
    <!-- FRONT -->
    <div class="card-face card-front glass">
      <div class="card-holo"></div>
      <div class="card-content">
        <div class="card-badge">
          <span class="mono text-xs tracking-widest text-lunar-300 uppercase">{astronaut.agency}</span>
        </div>
        <div class="card-photo">
          <div class="photo-placeholder">
            <span class="text-4xl">{astronaut.name.split(" ").map(n => n[0]).join("")}</span>
          </div>
        </div>
        <h3 class="text-xl font-semibold mt-4">{astronaut.name}</h3>
        <p class="text-accent-gold text-sm font-medium uppercase tracking-wider">{astronaut.role}</p>
        <p class="text-lunar-400 text-xs mt-1">{astronaut.nationality} · {astronaut.stats.background}</p>
        <div class="card-divider"></div>
        <p class="text-lunar-300 text-xs leading-relaxed line-clamp-3">{astronaut.bio}</p>
      </div>
      <div class="card-footer mono">
        <span class="text-[10px] text-lunar-400">ARTEMIS II · 2026</span>
        <span class="text-[10px] text-lunar-400">#{String(index + 1).padStart(2, "0")}/04</span>
      </div>
    </div>

    <!-- BACK -->
    <div class="card-face card-back glass">
      <div class="card-holo"></div>
      <div class="card-content">
        <h3 class="text-lg font-semibold mb-4">{astronaut.name}</h3>
        <div class="stats-grid">
          <div class="stat">
            <span class="stat-label">MISSIONS</span>
            <span class="stat-value mono">{astronaut.stats.missions}</span>
          </div>
          <div class="stat">
            <span class="stat-label">FLIGHT TIME</span>
            <span class="stat-value mono text-sm">{astronaut.stats.spaceflightTime}</span>
          </div>
          <div class="stat">
            <span class="stat-label">EVA TIME</span>
            <span class="stat-value mono text-sm">{astronaut.stats.evaTime}</span>
          </div>
          <div class="stat">
            <span class="stat-label">ROLE</span>
            <span class="stat-value text-sm text-accent-gold">{astronaut.role}</span>
          </div>
        </div>
        <div class="card-divider"></div>
        <div class="fun-fact">
          <span class="text-[10px] uppercase tracking-widest text-lunar-400">Fun Fact</span>
          <p class="text-lunar-200 text-xs mt-1 leading-relaxed">{astronaut.funFact}</p>
        </div>
      </div>
      <div class="card-footer mono">
        <span class="text-[10px] text-lunar-400">TAP TO FLIP</span>
        <span class="text-[10px] text-accent-cyan">INTEGRITY</span>
      </div>
    </div>
  </div>
</div>

<style>
  .card-container {
    perspective: 1200px;
    width: 280px;
    height: 400px;
    cursor: pointer;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .card-container.flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    padding: 20px;
    overflow: hidden;
  }

  .card-back {
    transform: rotateY(180deg);
  }

  /* Holographic shimmer overlay */
  .card-holo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
    background: conic-gradient(
      from var(--holo-angle, 0deg) at var(--holo-x, 50%) var(--holo-y, 50%),
      rgba(255, 255, 255, 0) 0%,
      rgba(59, 130, 246, 0.15) 20%,
      rgba(6, 182, 212, 0.15) 40%,
      rgba(245, 158, 11, 0.12) 60%,
      rgba(239, 68, 68, 0.1) 80%,
      rgba(255, 255, 255, 0) 100%
    );
    mix-blend-mode: overlay;
    pointer-events: none;
    border-radius: inherit;
    z-index: 2;
  }

  .card-container:hover .card-holo {
    opacity: 1;
  }

  .card-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .card-badge {
    align-self: flex-start;
  }

  .card-photo {
    margin-top: 12px;
  }

  .photo-placeholder {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-space-600), var(--color-space-500));
    border: 2px solid var(--color-glass-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    color: var(--color-lunar-300);
    font-family: var(--font-sans);
  }

  .card-divider {
    width: 40px;
    height: 1px;
    background: var(--color-glass-border);
    margin: 12px 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    width: 100%;
    text-align: left;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-lunar-400);
  }

  .stat-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-lunar-100);
  }

  .fun-fact {
    text-align: left;
    width: 100%;
  }

  /* Line clamp utility */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Card interactions: parallax tilt, holographic shimmer, flip
  document.querySelectorAll<HTMLDivElement>(".card-container").forEach((card) => {
    const holo = card.querySelector<HTMLDivElement>(".card-holo");

    // Parallax tilt on mousemove
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;

      const rotateX = (0.5 - y) * 20;
      const rotateY = (x - 0.5) * 20;

      const inner = card.querySelector<HTMLDivElement>(".card-inner");
      if (!inner) return;

      const isFlipped = card.classList.contains("flipped");
      const baseRotateY = isFlipped ? 180 : 0;
      inner.style.transform = `rotateX(${rotateX}deg) rotateY(${baseRotateY + rotateY}deg)`;
      inner.style.transition = "transform 0.1s ease-out";

      // Move holographic shimmer
      if (holo) {
        const holoAngle = Math.atan2(y - 0.5, x - 0.5) * (180 / Math.PI) + 180;
        card.style.setProperty("--holo-x", `${x * 100}%`);
        card.style.setProperty("--holo-y", `${y * 100}%`);
        card.style.setProperty("--holo-angle", `${holoAngle}deg`);
      }
    });

    // Reset tilt on mouse leave
    card.addEventListener("mouseleave", () => {
      const inner = card.querySelector<HTMLDivElement>(".card-inner");
      if (!inner) return;

      const isFlipped = card.classList.contains("flipped");
      inner.style.transform = isFlipped ? "rotateY(180deg)" : "";
      inner.style.transition = "transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)";
    });

    // Flip on click
    card.addEventListener("click", () => {
      card.classList.toggle("flipped");
      const inner = card.querySelector<HTMLDivElement>(".card-inner");
      if (inner) {
        inner.style.transition = "transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)";
      }
    });
  });
</script>
