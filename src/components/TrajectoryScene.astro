---
/**
 * TrajectoryScene — 3D Earth-Moon trajectory visualization
 * Uses vanilla Three.js with OrbitControls.
 * Falls back to an SVG on mobile (<768px) or when WebGL is unavailable.
 */
---

<!-- Mobile / fallback SVG -->
<div id="trajectory-fallback" class="hidden">
  <svg
    viewBox="0 0 800 400"
    class="w-full h-auto"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Artemis II trajectory from Earth to Moon and back"
  >
    <!-- Background -->
    <rect width="800" height="400" fill="#04060b" rx="12" />

    <!-- Stars -->
    <g fill="white" opacity="0.4">
      <circle cx="50" cy="30" r="1" /><circle cx="120" cy="80" r="0.8" />
      <circle cx="200" cy="50" r="1.2" /><circle cx="300" cy="20" r="0.7" />
      <circle cx="400" cy="60" r="1" /><circle cx="500" cy="35" r="0.9" />
      <circle cx="600" cy="70" r="1.1" /><circle cx="700" cy="25" r="0.8" />
      <circle cx="750" cy="90" r="1" /><circle cx="80" cy="350" r="0.9" />
      <circle cx="180" cy="320" r="1" /><circle cx="350" cy="370" r="0.7" />
      <circle cx="520" cy="350" r="1.1" /><circle cx="650" cy="380" r="0.8" />
      <circle cx="450" cy="300" r="0.6" /><circle cx="100" cy="200" r="0.9" />
      <circle cx="720" cy="200" r="1" /><circle cx="250" cy="150" r="0.7" />
    </g>

    <!-- Earth glow -->
    <defs>
      <radialGradient id="earth-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="moon-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#94a3b8" stop-opacity="0.2" />
        <stop offset="100%" stop-color="#94a3b8" stop-opacity="0" />
      </radialGradient>
    </defs>

    <!-- Earth glow halo -->
    <circle cx="150" cy="200" r="80" fill="url(#earth-glow)" />
    <!-- Earth -->
    <circle cx="150" cy="200" r="40" fill="#1e3a5f" stroke="#3b82f6" stroke-width="1" opacity="0.9" />
    <text x="150" y="270" text-anchor="middle" fill="#64748b" font-size="12" font-family="monospace">Earth</text>

    <!-- Moon glow halo -->
    <circle cx="650" cy="200" r="50" fill="url(#moon-glow)" />
    <!-- Moon -->
    <circle cx="650" cy="200" r="16" fill="#4a4a52" stroke="#94a3b8" stroke-width="0.8" opacity="0.9" />
    <text x="650" y="240" text-anchor="middle" fill="#64748b" font-size="12" font-family="monospace">Moon</text>

    <!-- Trajectory path (figure-eight approximation) -->
    <path
      d="M 190 200 C 300 80, 500 80, 640 185 C 660 200, 660 200, 640 215 C 500 320, 300 320, 190 200 Z"
      fill="none"
      stroke="#06b6d4"
      stroke-width="1.5"
      stroke-dasharray="6 3"
      opacity="0.6"
    />

    <!-- Orion marker -->
    <circle cx="400" cy="105" r="5" fill="#f59e0b" opacity="0.9">
      <animate attributeName="opacity" values="0.9;0.5;0.9" dur="2s" repeatCount="indefinite" />
    </circle>
    <circle cx="400" cy="105" r="10" fill="#f59e0b" opacity="0.2">
      <animate attributeName="r" values="10;16;10" dur="2s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.2;0;0.2" dur="2s" repeatCount="indefinite" />
    </circle>
    <text x="400" y="95" text-anchor="middle" fill="#f59e0b" font-size="10" font-family="monospace">Orion</text>

    <!-- Direction arrows -->
    <polygon points="350,90 355,85 355,95" fill="#06b6d4" opacity="0.5" />
    <polygon points="450,115 445,110 445,120" fill="#06b6d4" opacity="0.5" transform="rotate(180 447 115)" />
  </svg>
</div>

<!-- 3D Canvas container -->
<div id="trajectory-canvas" class="relative w-full aspect-video rounded-xl overflow-hidden">
  <canvas id="trajectory-gl" class="w-full h-full block"></canvas>
  <!-- Loading overlay -->
  <div id="trajectory-loading" class="absolute inset-0 flex items-center justify-center bg-space-900/80 backdrop-blur-sm transition-opacity duration-500">
    <div class="text-center">
      <div class="inline-block w-8 h-8 border-2 border-accent-cyan/30 border-t-accent-cyan rounded-full animate-spin mb-3"></div>
      <p class="mono text-xs text-lunar-400">Initializing trajectory...</p>
    </div>
  </div>
</div>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/addons/controls/OrbitControls.js";
  import { MISSION } from "@/lib/mission";
  import { loadTrajectory, interpolatePosition, type TrajectoryData } from "@/lib/trajectory";

  // ---------------------------------------------------------------------------
  // Helpers
  // ---------------------------------------------------------------------------

  function getMissionElapsedTime(): number {
    const now = Date.now();
    const launch = MISSION.launchTime.getTime();
    return Math.max(0, (now - launch) / 1000);
  }

  function isWebGLAvailable(): boolean {
    try {
      const canvas = document.createElement("canvas");
      return !!(
        window.WebGLRenderingContext &&
        (canvas.getContext("webgl") || canvas.getContext("experimental-webgl"))
      );
    } catch {
      return false;
    }
  }

  // ---------------------------------------------------------------------------
  // Mobile / WebGL detection — show fallback if needed
  // ---------------------------------------------------------------------------

  const isMobile = window.innerWidth < 768;
  const fallbackEl = document.getElementById("trajectory-fallback")!;
  const canvasContainer = document.getElementById("trajectory-canvas")!;

  if (isMobile || !isWebGLAvailable()) {
    fallbackEl.classList.remove("hidden");
    canvasContainer.classList.add("hidden");
  } else {
    fallbackEl.classList.add("hidden");
    canvasContainer.classList.remove("hidden");
    initScene();
  }

  // ---------------------------------------------------------------------------
  // Three.js Scene
  // ---------------------------------------------------------------------------

  function initScene(): void {
    const canvas = document.getElementById("trajectory-gl") as HTMLCanvasElement;
    const loadingEl = document.getElementById("trajectory-loading")!;

    // Renderer
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: false,
    });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(canvas.clientWidth, canvas.clientHeight, false);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;

    // Scene
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x04060b);

    // Camera
    const aspect = canvas.clientWidth / canvas.clientHeight;
    const camera = new THREE.PerspectiveCamera(45, aspect, 0.1, 2000);
    camera.position.set(0, 80, 200);
    camera.lookAt(0, 0, 0);

    // Controls
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.minDistance = 50;
    controls.maxDistance = 500;
    controls.enablePan = false;
    controls.autoRotate = false;
    controls.target.set(30, 0, 0);

    // -----------------------------------------------------------------------
    // Lighting
    // -----------------------------------------------------------------------

    // Subtle ambient
    scene.add(new THREE.AmbientLight(0x1a2236, 0.4));

    // Sun-like directional light (from far right-ish, simulating sun)
    const sunLight = new THREE.DirectionalLight(0xfff5e6, 1.8);
    sunLight.position.set(200, 50, 100);
    scene.add(sunLight);

    // Fill light from the opposite side
    const fillLight = new THREE.DirectionalLight(0x3b82f6, 0.15);
    fillLight.position.set(-100, -20, -50);
    scene.add(fillLight);

    // -----------------------------------------------------------------------
    // Star field
    // -----------------------------------------------------------------------

    const starCount = 2000;
    const starPositions = new Float32Array(starCount * 3);
    for (let i = 0; i < starCount; i++) {
      const r = 400 + Math.random() * 600;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      starPositions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
      starPositions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
      starPositions[i * 3 + 2] = r * Math.cos(phi);
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute("position", new THREE.BufferAttribute(starPositions, 3));
    const starMat = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.6,
      sizeAttenuation: true,
      transparent: true,
      opacity: 0.7,
    });
    scene.add(new THREE.Points(starGeo, starMat));

    // -----------------------------------------------------------------------
    // Earth
    // -----------------------------------------------------------------------

    const earthRadius = 12;
    const earthGeo = new THREE.IcosahedronGeometry(earthRadius, 2); // low-poly
    const earthMat = new THREE.MeshStandardMaterial({
      color: 0x1e4a7a,
      roughness: 0.8,
      metalness: 0.1,
      flatShading: true,
    });
    const earth = new THREE.Mesh(earthGeo, earthMat);
    earth.position.set(0, 0, 0);
    scene.add(earth);

    // Earth atmosphere glow (additive sprite)
    const earthGlow = createGlowSprite(0x3b82f6, earthRadius * 3.5, 0.12);
    earth.add(earthGlow);

    // -----------------------------------------------------------------------
    // Moon
    // -----------------------------------------------------------------------

    const moonDistance = 120; // scene units (not to scale, but visually clear)
    const moonRadius = 3.5;
    const moonGeo = new THREE.IcosahedronGeometry(moonRadius, 2);
    const moonMat = new THREE.MeshStandardMaterial({
      color: 0x8a8a8f,
      roughness: 0.9,
      metalness: 0.05,
      flatShading: true,
    });
    const moon = new THREE.Mesh(moonGeo, moonMat);
    moon.position.set(moonDistance, 0, 0);
    scene.add(moon);

    const moonGlow = createGlowSprite(0x94a3b8, moonRadius * 3.0, 0.08);
    moon.add(moonGlow);

    // -----------------------------------------------------------------------
    // Trajectory path — loaded from JPL Horizons API
    //
    // Real data is in km (J2000 ecliptic, Earth-centered).
    // Scale: moonDistance scene units = 384,400 km
    // -----------------------------------------------------------------------

    const SCALE = moonDistance / 384_400; // scene units per km

    function kmToScene(x: number, y: number, z: number): THREE.Vector3 {
      return new THREE.Vector3(x * SCALE, z * SCALE, -y * SCALE);
    }

    // Trajectory line and curve — built once data loads.
    let trajectoryCurve: THREE.CatmullRomCurve3 | null = null;
    let trajectoryLine: THREE.Line | null = null;
    let trajectoryData: TrajectoryData | null = null;

    // Start with a placeholder line; replace once Horizons data arrives.
    const placeholderGeo = new THREE.BufferGeometry();
    const lineMat = new THREE.LineBasicMaterial({
      color: 0x06b6d4,
      transparent: true,
      opacity: 0.4,
    });
    trajectoryLine = new THREE.Line(placeholderGeo, lineMat);
    scene.add(trajectoryLine);

    // Fetch real data and build the curve
    loadTrajectory().then((data) => {
      trajectoryData = data;

      // Build spacecraft trajectory curve from real positions
      const scenePoints = data.spacecraft.map((s) => kmToScene(s.x, s.y, s.z));
      trajectoryCurve = new THREE.CatmullRomCurve3(scenePoints, false, "catmullrom", 0.3);
      const curvePoints = trajectoryCurve.getPoints(500);

      // Update the trajectory line
      const lineGeo = new THREE.BufferGeometry().setFromPoints(curvePoints);
      if (trajectoryLine) {
        trajectoryLine.geometry.dispose();
        trajectoryLine.geometry = lineGeo;
      }

      // Update Moon position from real data (use mid-mission Moon position)
      const midIdx = Math.floor(data.moon.length / 2);
      if (data.moon[midIdx]) {
        const moonPos = kmToScene(data.moon[midIdx].x, data.moon[midIdx].y, data.moon[midIdx].z);
        moon.position.copy(moonPos);
        controls.target.set(moonPos.x / 2, 0, moonPos.z / 2); // center between Earth and Moon
      }

      console.info(`[TrajectoryScene] Loaded ${data.spacecraft.length} trajectory points`);
    });

    // -----------------------------------------------------------------------
    // Orion capsule (glowing dot)
    // -----------------------------------------------------------------------

    const orionGeo = new THREE.SphereGeometry(1.2, 16, 16);
    const orionMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
    const orion = new THREE.Mesh(orionGeo, orionMat);
    scene.add(orion);

    // Orion glow
    const orionGlow = createGlowSprite(0xf59e0b, 8, 0.35);
    orion.add(orionGlow);

    // Outer pulse ring
    const orionPulse = createGlowSprite(0xf59e0b, 14, 0.12);
    orion.add(orionPulse);

    // -----------------------------------------------------------------------
    // Mission progress → Orion position
    // Uses real Horizons data when available, falls back to curve parameter.
    // -----------------------------------------------------------------------

    const totalMissionSeconds =
      (MISSION.splashdownTime.getTime() - MISSION.launchTime.getTime()) / 1000;

    function getOrionPosition(): THREE.Vector3 | null {
      // If we have real data, interpolate from Horizons positions
      if (trajectoryData) {
        const pos = interpolatePosition(trajectoryData.spacecraft, new Date());
        if (pos) return kmToScene(pos.x, pos.y, pos.z);
      }
      // Fallback: use curve parameter
      if (trajectoryCurve) {
        const met = getMissionElapsedTime();
        const t = Math.max(0, Math.min(0.999, met / totalMissionSeconds));
        return trajectoryCurve.getPointAt(t);
      }
      return null;
    }

    // -----------------------------------------------------------------------
    // Animation loop — target 30fps
    // -----------------------------------------------------------------------

    const clock = new THREE.Clock();
    const frameInterval = 1 / 30;
    let elapsed = 0;
    let animationId: number;

    function animate(): void {
      animationId = requestAnimationFrame(animate);

      elapsed += clock.getDelta();
      if (elapsed < frameInterval) return;
      elapsed = elapsed % frameInterval;

      // Slow Earth rotation
      earth.rotation.y += 0.002;

      // Orion position
      const pos = getOrionPosition();
      if (pos) orion.position.copy(pos);

      // Pulse effect on Orion glow
      const pulse = 0.3 + 0.1 * Math.sin(Date.now() * 0.003);
      (orionGlow.material as THREE.SpriteMaterial).opacity = pulse;
      const pulseOuter = 0.08 + 0.06 * Math.sin(Date.now() * 0.002);
      (orionPulse.material as THREE.SpriteMaterial).opacity = pulseOuter;

      controls.update();
      renderer.render(scene, camera);
    }

    animate();

    // Hide loading overlay
    requestAnimationFrame(() => {
      loadingEl.style.opacity = "0";
      setTimeout(() => loadingEl.remove(), 500);
    });

    // -----------------------------------------------------------------------
    // Resize handling
    // -----------------------------------------------------------------------

    function onResize(): void {
      const w = canvasContainer.clientWidth;
      const h = canvasContainer.clientHeight;
      if (w === 0 || h === 0) return;

      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
    }

    const resizeObserver = new ResizeObserver(onResize);
    resizeObserver.observe(canvasContainer);

    // Also switch to SVG fallback if resized to mobile
    window.addEventListener("resize", () => {
      if (window.innerWidth < 768) {
        fallbackEl.classList.remove("hidden");
        canvasContainer.classList.add("hidden");
        cleanup();
      }
    });

    // -----------------------------------------------------------------------
    // Cleanup
    // -----------------------------------------------------------------------

    function cleanup(): void {
      cancelAnimationFrame(animationId);
      resizeObserver.disconnect();
      controls.dispose();
      renderer.dispose();
      scene.traverse((obj) => {
        if (obj instanceof THREE.Mesh || obj instanceof THREE.Line || obj instanceof THREE.Points) {
          obj.geometry.dispose();
          if (Array.isArray(obj.material)) {
            obj.material.forEach((m) => m.dispose());
          } else {
            obj.material.dispose();
          }
        }
        if (obj instanceof THREE.Sprite) {
          obj.material.map?.dispose();
          obj.material.dispose();
        }
      });
    }

    // Cleanup on page navigation (Astro view transitions)
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

  // ---------------------------------------------------------------------------
  // Glow sprite helper — creates a radial gradient texture for halos
  // ---------------------------------------------------------------------------

  function createGlowSprite(color: number, size: number, opacity: number): THREE.Sprite {
    const canvas = document.createElement("canvas");
    canvas.width = 128;
    canvas.height = 128;
    const ctx = canvas.getContext("2d")!;
    const gradient = ctx.createRadialGradient(64, 64, 0, 64, 64, 64);
    const c = new THREE.Color(color);
    const hex = `rgb(${Math.floor(c.r * 255)},${Math.floor(c.g * 255)},${Math.floor(c.b * 255)})`;
    gradient.addColorStop(0, hex);
    gradient.addColorStop(0.4, hex.replace("rgb", "rgba").replace(")", ",0.3)"));
    gradient.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, 128, 128);

    const texture = new THREE.CanvasTexture(canvas);
    const mat = new THREE.SpriteMaterial({
      map: texture,
      transparent: true,
      opacity,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const sprite = new THREE.Sprite(mat);
    sprite.scale.set(size, size, 1);
    return sprite;
  }
</script>
