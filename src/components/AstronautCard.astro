---
import type { Astronaut } from "../lib/astronauts";

interface Props {
  astronaut: Astronaut;
  index: number;
}

const { astronaut, index } = Astro.props;
---

<div class="card-container" data-card-index={index}>
  <div class="card-inner">
    <!-- FRONT -->
    <div class="card-face card-front glass">
      <div class="card-holo"></div>
      <div class="card-content">
        <div class="flex items-center justify-between w-full mb-4">
          <span class="mono text-[10px] tracking-[0.2em] text-lunar-400 uppercase">{astronaut.agency}</span>
          <span class="mono text-[10px] text-lunar-400">#{String(index + 1).padStart(2, "0")}/04</span>
        </div>

        <img
          src={astronaut.photo}
          alt={astronaut.name}
          class="crew-photo"
          loading="lazy"
          width="120"
          height="120"
        />

        <h3 class="font-heading font-extrabold text-lg mt-5 tracking-wide uppercase">{astronaut.name}</h3>
        <p class="mono text-[11px] text-accent-gold tracking-[0.15em] uppercase mt-1">{astronaut.role}</p>
        <p class="text-lunar-400 text-xs mt-1">{astronaut.nationality} · {astronaut.stats.background}</p>

        <div class="w-8 h-px bg-glass-border my-4"></div>

        <p class="text-lunar-300 text-[13px] leading-relaxed line-clamp-3 text-center">{astronaut.bio}</p>
      </div>
      <div class="mt-auto pt-3 flex justify-center w-full">
        <span class="mono text-[9px] text-lunar-400/40 uppercase tracking-widest">Tap to flip</span>
      </div>
    </div>

    <!-- BACK -->
    <div class="card-face card-back glass">
      <div class="card-holo"></div>
      <div class="card-content">
        <h3 class="font-heading font-extrabold text-base uppercase tracking-wide mb-5">{astronaut.name}</h3>

        <div class="grid grid-cols-2 gap-4 w-full text-left">
          <div>
            <span class="mono text-[9px] text-lunar-400 uppercase tracking-wider">Missions</span>
            <p class="mono text-xl font-medium text-lunar-100 mt-0.5">{astronaut.stats.missions}</p>
          </div>
          <div>
            <span class="mono text-[9px] text-lunar-400 uppercase tracking-wider">Flight Time</span>
            <p class="mono text-sm font-medium text-lunar-100 mt-0.5">{astronaut.stats.spaceflightTime}</p>
          </div>
          <div>
            <span class="mono text-[9px] text-lunar-400 uppercase tracking-wider">EVA Time</span>
            <p class="mono text-sm font-medium text-lunar-100 mt-0.5">{astronaut.stats.evaTime}</p>
          </div>
          <div>
            <span class="mono text-[9px] text-lunar-400 uppercase tracking-wider">Role</span>
            <p class="text-sm font-medium text-accent-gold mt-0.5">{astronaut.role}</p>
          </div>
        </div>

        <div class="w-8 h-px bg-glass-border my-5"></div>

        <div class="w-full text-left">
          <span class="mono text-[9px] uppercase tracking-[0.2em] text-lunar-400">Fun Fact</span>
          <p class="text-lunar-200 text-[13px] mt-1.5 leading-relaxed">{astronaut.funFact}</p>
        </div>
      </div>
      <div class="mt-auto pt-3 flex items-center justify-between w-full">
        <span class="font-display text-[10px] uppercase tracking-wider text-lunar-400/30">Artemis II</span>
        <span class="mono text-[10px] text-accent-cyan/50">Integrity</span>
      </div>
    </div>
  </div>
</div>

<style>
  .card-container {
    perspective: 1200px;
    width: 100%;
    height: 480px;
    cursor: pointer;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .card-container.flipped .card-inner {
    transform: rotateY(180deg);
  }

  .card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    display: flex;
    flex-direction: column;
    padding: 24px;
    overflow: hidden;
  }

  .card-back {
    transform: rotateY(180deg);
  }

  /* Holographic shimmer */
  .card-holo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
    background: conic-gradient(
      from var(--holo-angle, 0deg) at var(--holo-x, 50%) var(--holo-y, 50%),
      rgba(255, 255, 255, 0) 0%,
      rgba(59, 130, 246, 0.18) 20%,
      rgba(6, 182, 212, 0.18) 40%,
      rgba(245, 158, 11, 0.15) 60%,
      rgba(239, 68, 68, 0.1) 80%,
      rgba(255, 255, 255, 0) 100%
    );
    mix-blend-mode: overlay;
    pointer-events: none;
    border-radius: inherit;
    z-index: 2;
  }

  .card-container:hover .card-holo {
    opacity: 1;
  }

  .card-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .crew-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 2px solid var(--color-glass-border);
    background: linear-gradient(135deg, var(--color-space-600), var(--color-space-500));
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>(".card-container").forEach((card) => {
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const rotateX = (0.5 - y) * 15;
      const rotateY = (x - 0.5) * 15;

      const inner = card.querySelector<HTMLDivElement>(".card-inner");
      if (!inner) return;
      const baseY = card.classList.contains("flipped") ? 180 : 0;
      inner.style.transform = `rotateX(${rotateX}deg) rotateY(${baseY + rotateY}deg)`;
      inner.style.transition = "transform 0.1s ease-out";

      const holoAngle = Math.atan2(y - 0.5, x - 0.5) * (180 / Math.PI) + 180;
      card.style.setProperty("--holo-x", `${x * 100}%`);
      card.style.setProperty("--holo-y", `${y * 100}%`);
      card.style.setProperty("--holo-angle", `${holoAngle}deg`);
    });

    card.addEventListener("mouseleave", () => {
      const inner = card.querySelector<HTMLDivElement>(".card-inner");
      if (!inner) return;
      inner.style.transform = card.classList.contains("flipped") ? "rotateY(180deg)" : "";
      inner.style.transition = "transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)";
    });

    card.addEventListener("click", () => {
      card.classList.toggle("flipped");
    });
  });
</script>
