---
import type { Astronaut } from "../lib/astronauts";

interface Props {
  astronaut: Astronaut;
  index: number;
}

const { astronaut, index } = Astro.props;
---

<div class="card-container" data-card-index={index} role="button" tabindex="0" aria-label={`${astronaut.name}, ${astronaut.role}. Tap to flip card for details.`}>
  <div class="card-outer-glow"></div>
  <div class="card-inner">
    <!-- FRONT -->
    <div class="card-face card-front glass">
      <div class="card-border-glow"></div>
      <div class="card-holo"></div>
      <div class="card-content">
        <div class="flex items-center justify-between w-full mb-4">
          <span class="mono text-[10px] tracking-[0.2em] text-lunar-300 uppercase">{astronaut.agency}</span>
          <span class="mono text-[10px] text-lunar-300">#{String(index + 1).padStart(2, "0")}/04</span>
        </div>

        <img
          src={astronaut.photo}
          alt={astronaut.name}
          class="crew-photo"
          loading="lazy"
          width="120"
          height="120"
        />

        <h3 class="font-heading font-extrabold text-lg mt-5 tracking-wide uppercase">{astronaut.name}</h3>
        <p class="mono text-[11px] text-accent-gold tracking-[0.15em] uppercase mt-1">{astronaut.role}</p>
        <p class="text-lunar-300 text-xs mt-1">{astronaut.nationality} · {astronaut.stats.background}</p>

        <div class="w-8 h-px bg-glass-border my-4"></div>

        <p class="text-lunar-300 text-[13px] leading-relaxed line-clamp-3 text-center">{astronaut.bio}</p>
      </div>
      <div class="mt-auto pt-3 flex justify-center w-full">
        <span class="mono text-[10px] text-lunar-300 uppercase tracking-widest">Tap to flip ↻</span>
      </div>
    </div>

    <!-- BACK -->
    <div class="card-face card-back glass">
      <div class="card-border-glow"></div>
      <div class="card-holo"></div>
      <div class="card-content">
        <h3 class="font-heading font-extrabold text-base uppercase tracking-wide mb-5">{astronaut.name}</h3>

        <div class="grid grid-cols-2 gap-4 w-full text-left">
          <div>
            <span class="mono text-[9px] text-lunar-300 uppercase tracking-wider">Missions</span>
            <p class="mono text-xl font-medium text-lunar-100 mt-0.5">{astronaut.stats.missions}</p>
          </div>
          <div>
            <span class="mono text-[9px] text-lunar-300 uppercase tracking-wider">Flight Time</span>
            <p class="mono text-sm font-medium text-lunar-100 mt-0.5">{astronaut.stats.spaceflightTime}</p>
          </div>
          <div>
            <span class="mono text-[9px] text-lunar-300 uppercase tracking-wider">EVA Time</span>
            <p class="mono text-sm font-medium text-lunar-100 mt-0.5">{astronaut.stats.evaTime}</p>
          </div>
          <div>
            <span class="mono text-[9px] text-lunar-300 uppercase tracking-wider">Role</span>
            <p class="text-sm font-medium text-accent-gold mt-0.5">{astronaut.role}</p>
          </div>
        </div>

        <div class="w-8 h-px bg-glass-border my-5"></div>

        <div class="w-full text-left">
          <span class="mono text-[9px] uppercase tracking-[0.2em] text-lunar-300">Fun Fact</span>
          <p class="text-lunar-200 text-[13px] mt-1.5 leading-relaxed">{astronaut.funFact}</p>
        </div>
      </div>
      <div class="mt-auto pt-3 flex items-center justify-between w-full">
        <span class="font-display text-[10px] uppercase tracking-wider text-lunar-300/50">Artemis II</span>
        <span class="mono text-[10px] text-accent-cyan/80">Integrity</span>
      </div>
    </div>
  </div>
</div>

<style>
  .card-container {
    width: 100%;
    height: 480px;
    cursor: pointer;
  }

  .card-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .card-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: opacity 0.4s ease, visibility 0.4s ease, border-color 0.4s, box-shadow 0.4s;
  }

  .card-container:hover .card-face {
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow:
      0 0 20px rgba(59, 130, 246, 0.1),
      0 0 60px rgba(6, 182, 212, 0.05),
      inset 0 0 30px rgba(59, 130, 246, 0.03);
  }

  /* Front: visible by default, hidden when flipped */
  .card-front {
    opacity: 1;
    visibility: visible;
  }
  .card-container.flipped .card-front {
    opacity: 0;
    visibility: hidden;
  }

  /* Back: hidden by default, visible when flipped */
  .card-back {
    opacity: 0;
    visibility: hidden;
  }
  .card-container.flipped .card-back {
    opacity: 1;
    visibility: visible;
  }

  /* Animated border glow — follows mouse position */
  .card-border-glow {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
    z-index: 3;
    background: radial-gradient(
      300px circle at var(--glow-x, 50%) var(--glow-y, 50%),
      rgba(59, 130, 246, 0.15),
      rgba(6, 182, 212, 0.08) 40%,
      transparent 70%
    );
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    padding: 1px;
  }

  .card-container:hover .card-border-glow {
    opacity: 1;
  }

  /* Holographic shimmer */
  .card-holo {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s;
    background: conic-gradient(
      from var(--holo-angle, 0deg) at var(--holo-x, 50%) var(--holo-y, 50%),
      rgba(255, 255, 255, 0) 0%,
      rgba(59, 130, 246, 0.25) 15%,
      rgba(6, 182, 212, 0.25) 30%,
      rgba(245, 158, 11, 0.2) 45%,
      rgba(168, 85, 247, 0.15) 60%,
      rgba(239, 68, 68, 0.12) 75%,
      rgba(255, 255, 255, 0) 100%
    );
    mix-blend-mode: overlay;
    pointer-events: none;
    border-radius: inherit;
    z-index: 2;
  }

  .card-container:hover .card-holo {
    opacity: 1;
  }

  /* Outer glow behind the card */
  .card-outer-glow {
    position: absolute;
    inset: -4px;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
    z-index: -1;
    background: radial-gradient(
      400px circle at var(--glow-x, 50%) var(--glow-y, 50%),
      rgba(59, 130, 246, 0.1),
      transparent 60%
    );
    filter: blur(8px);
  }

  .card-container:hover .card-outer-glow {
    opacity: 1;
  }

  .card-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .crew-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top center;
    border: 2px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(135deg, var(--color-space-600), var(--color-space-500));
    transition: border-color 0.4s, box-shadow 0.4s;
  }

  .card-container:hover .crew-photo {
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.15), 0 0 40px rgba(6, 182, 212, 0.08);
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.querySelectorAll<HTMLDivElement>(".card-container").forEach((card) => {
    // Parallax tilt on hover (desktop only)
    card.addEventListener("mousemove", (e) => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width;
      const y = (e.clientY - rect.top) / rect.height;
      const rotateX = (0.5 - y) * 15;
      const rotateY = (x - 0.5) * 15;

      card.style.transform = `perspective(1200px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      card.style.transition = "transform 0.1s ease-out";

      // Holographic shimmer
      const holoAngle = Math.atan2(y - 0.5, x - 0.5) * (180 / Math.PI) + 180;
      card.style.setProperty("--holo-x", `${x * 100}%`);
      card.style.setProperty("--holo-y", `${y * 100}%`);
      card.style.setProperty("--holo-angle", `${holoAngle}deg`);

      // Border glow + outer glow follow mouse
      card.style.setProperty("--glow-x", `${x * 100}%`);
      card.style.setProperty("--glow-y", `${y * 100}%`);
    });

    card.addEventListener("mouseleave", () => {
      card.style.transform = "";
      card.style.transition = "transform 0.5s cubic-bezier(0.4, 0, 0.2, 1)";
    });

    // Flip on click/tap
    card.addEventListener("click", () => {
      card.classList.toggle("flipped");
    });

    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        card.classList.toggle("flipped");
      }
    });
  });
</script>
