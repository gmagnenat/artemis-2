---
import { MISSION } from "../lib/mission";
---

<div id="mission-status" class="glass px-6 sm:px-8 py-6">
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-6 text-center sm:text-left">
    <div class="status-item">
      <span class="label">Mission Elapsed Time</span>
      <span id="met-display" class="value mono">--:--:--:--</span>
    </div>
    <div class="status-item">
      <span class="label">Current Phase</span>
      <span id="phase-display" class="value font-heading font-extrabold text-accent-gold">Loading...</span>
    </div>
    <div class="status-item">
      <span class="label">Earth Distance</span>
      <span id="earth-distance" class="value mono">--- km</span>
    </div>
    <div class="status-item">
      <span class="label">Moon Distance</span>
      <span id="moon-distance" class="value mono">--- km</span>
    </div>
    <div class="status-item">
      <span class="label">Velocity</span>
      <span id="velocity-display" class="value mono text-accent-cyan">--- km/h</span>
    </div>
  </div>
</div>

<style>
  .status-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-lunar-300);
  }

  .value {
    font-size: 20px;
    font-weight: 500;
    color: var(--color-lunar-100);
  }
</style>

<script>
  import { getMissionElapsedTime, getMissionPhase, formatMET, isArchiveMode, MISSION } from "../lib/mission";
  import { loadTrajectory, getDistancesAt, interpolatePosition, magnitude, type TrajectoryData, type DistanceSample } from "../lib/trajectory";

  const metDisplay = document.getElementById("met-display")!;
  const phaseDisplay = document.getElementById("phase-display")!;
  const earthDistance = document.getElementById("earth-distance")!;
  const moonDistance = document.getElementById("moon-distance")!;
  const velocityDisplay = document.getElementById("velocity-display")!;

  // Trajectory state — starts null, populated once the async fetch completes.
  let trajectoryData: TrajectoryData | null = null;

  // Kick off the Horizons fetch immediately.
  loadTrajectory().then((data) => {
    trajectoryData = data;
    if (data.isFallback) {
      console.info("[MissionStatus] Using fallback trajectory data");
    } else {
      console.info(
        `[MissionStatus] Loaded ${data.spacecraft.length} spacecraft + ${data.moon.length} moon samples from Horizons`,
      );
    }
    // Force an immediate refresh with the new data.
    update();
  });

  function getDistances(): DistanceSample {
    if (trajectoryData) {
      return getDistancesAt(trajectoryData.spacecraft, trajectoryData.moon, new Date());
    }
    // Before data loads, return a rough estimate so the UI is not blank.
    const met = getMissionElapsedTime();
    const totalMission = (MISSION.splashdownTime.getTime() - MISSION.launchTime.getTime()) / 1000;
    const progress = Math.min(1, met / totalMission);
    const peakProgress = 0.55;
    let earthDist: number;
    if (progress < peakProgress) {
      earthDist = (progress / peakProgress) * MISSION.maxEarthDistance;
    } else {
      earthDist = MISSION.maxEarthDistance * (1 - (progress - peakProgress) / (1 - peakProgress));
    }
    return {
      earth: Math.max(0, earthDist),
      moon: Math.max(0, Math.abs(376_292 - earthDist)),
    };
  }

  function formatDist(km: number): string {
    if (km >= 1_000) return `${(km / 1_000).toFixed(1)}K km`;
    return `${km.toFixed(0)} km`;
  }

  /**
   * Compute spacecraft velocity in km/h by differencing two positions
   * a small time delta apart (±30 seconds).
   */
  function getVelocity(): number {
    if (!trajectoryData) return 0;
    const now = Date.now();
    const deltaMs = 30_000; // 30 seconds
    const t1 = new Date(now - deltaMs);
    const t2 = new Date(now + deltaMs);
    const p1 = interpolatePosition(trajectoryData.spacecraft, t1);
    const p2 = interpolatePosition(trajectoryData.spacecraft, t2);
    const dx = p2.x - p1.x;
    const dy = p2.y - p1.y;
    const dz = p2.z - p1.z;
    const distKm = Math.sqrt(dx * dx + dy * dy + dz * dz);
    const dtHours = (2 * deltaMs) / 3_600_000; // total interval in hours
    return distKm / dtHours;
  }

  function formatVelocity(kmh: number): string {
    return kmh.toLocaleString("en-US", { maximumFractionDigits: 0 }) + " km/h";
  }

  function update() {
    const met = getMissionElapsedTime();
    const phase = getMissionPhase(met);
    const distances = getDistances();
    const velocity = getVelocity();

    metDisplay.textContent = formatMET(met);
    phaseDisplay.textContent = phase.label;
    phaseDisplay.style.color = phase.color;
    earthDistance.textContent = formatDist(distances.earth);
    moonDistance.textContent = formatDist(distances.moon);
    velocityDisplay.textContent = velocity > 0 ? formatVelocity(velocity) : "--- km/h";

    if (isArchiveMode()) {
      metDisplay.textContent = `✓ ${formatMET(met)}`;
    }
  }

  update();
  setInterval(update, 1000);
</script>
