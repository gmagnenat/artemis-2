---
/**
 * TrajectoryScene — Mission Control display with NASA live video backdrop.
 * Cinematic telemetry overlay on real Artemis II footage.
 */
import { MISSION } from "../lib/mission";
---

<section id="mission-control" class="relative w-full overflow-hidden rounded-xl">
  <!-- NASA Live Video Background -->
  <div class="relative aspect-video w-full bg-space-900">
    <iframe
      id="nasa-live"
      src="https://www.youtube.com/embed/6RwfNBtepa4?autoplay=1&mute=1&controls=0&showinfo=0&rel=0&loop=1&modestbranding=1&playsinline=1"
      class="absolute inset-0 w-full h-full"
      allow="autoplay; encrypted-media"
      allowfullscreen
      loading="lazy"
    ></iframe>

    <!-- Dark vignette overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-space-900 via-space-900/60 to-space-900/30 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-space-900/50 via-transparent to-space-900/50 pointer-events-none"></div>

    <!-- Scanline effect -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]" style="background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255,255,255,0.05) 2px, rgba(255,255,255,0.05) 4px);"></div>

    <!-- Mission Control Overlay -->
    <div class="absolute inset-0 flex flex-col justify-between p-4 sm:p-6 pointer-events-none">

      <!-- Top bar: mission identity -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
          <span class="mono text-[11px] tracking-widest text-green-400/80 uppercase">Live from Orion</span>
        </div>
        <div class="mono text-[11px] tracking-wider text-lunar-400/60 uppercase">
          Artemis II · Day <span id="mc-day">--</span>
        </div>
      </div>

      <!-- Center: trajectory diagram (clean, minimal) -->
      <div class="flex-1 flex items-center justify-center">
        <svg id="mc-trajectory" viewBox="0 0 600 200" class="w-full max-w-2xl h-auto opacity-80">
          <!-- Trajectory path -->
          <path
            d="M 60 100 C 150 40, 300 20, 420 50 C 480 65, 520 85, 535 100 C 545 112, 545 118, 535 128 C 520 145, 480 160, 420 155 C 300 145, 150 140, 60 100"
            fill="none"
            stroke="#06b6d4"
            stroke-width="1"
            opacity="0.3"
          />
          <!-- Completed path -->
          <path
            id="mc-completed-path"
            d=""
            fill="none"
            stroke="#06b6d4"
            stroke-width="2"
            opacity="0.6"
            stroke-linecap="round"
          />

          <!-- Earth -->
          <circle cx="60" cy="100" r="12" fill="#0f2847" stroke="#3b82f6" stroke-width="1" opacity="0.8" />
          <text x="60" y="125" text-anchor="middle" fill="#3b82f6" font-size="9" font-family="'JetBrains Mono', monospace" opacity="0.5">EARTH</text>

          <!-- Moon -->
          <circle cx="535" cy="114" r="5" fill="#3a3a40" stroke="#94a3b8" stroke-width="0.8" opacity="0.8" />
          <text x="535" y="132" text-anchor="middle" fill="#94a3b8" font-size="9" font-family="'JetBrains Mono', monospace" opacity="0.5">MOON</text>

          <!-- Orion dot -->
          <circle id="mc-orion-glow" cx="60" cy="100" r="10" fill="#f59e0b" opacity="0.15">
            <animate attributeName="r" values="10;16;10" dur="2.5s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.15;0;0.15" dur="2.5s" repeatCount="indefinite" />
          </circle>
          <circle id="mc-orion" cx="60" cy="100" r="3.5" fill="#f59e0b" />
        </svg>
      </div>

      <!-- Bottom: telemetry grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4">
        <div class="mc-tel glass !bg-space-900/60 p-3 rounded-lg">
          <span class="mc-label">MET</span>
          <span id="mc-met" class="mc-value mono">--:--:--:--</span>
        </div>
        <div class="mc-tel glass !bg-space-900/60 p-3 rounded-lg">
          <span class="mc-label">PHASE</span>
          <span id="mc-phase" class="mc-value text-accent-gold">---</span>
        </div>
        <div class="mc-tel glass !bg-space-900/60 p-3 rounded-lg">
          <span class="mc-label">EARTH DIST</span>
          <span id="mc-earth-dist" class="mc-value mono">--- km</span>
        </div>
        <div class="mc-tel glass !bg-space-900/60 p-3 rounded-lg">
          <span class="mc-label">MOON DIST</span>
          <span id="mc-moon-dist" class="mc-value mono">--- km</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mc-tel {
    display: flex;
    flex-direction: column;
    gap: 2px;
    pointer-events: auto;
  }
  .mc-label {
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-lunar-400);
    opacity: 0.6;
    font-family: var(--font-mono);
  }
  .mc-value {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-lunar-100);
  }
  @media (max-width: 640px) {
    .mc-value { font-size: 13px; }
  }
</style>

<script>
  import { getMissionElapsedTime, getMissionPhase, formatMET, MISSION } from "../lib/mission";
  import { loadTrajectory, getDistancesAt, type TrajectoryData } from "../lib/trajectory";

  // Elements
  const metEl = document.getElementById("mc-met")!;
  const phaseEl = document.getElementById("mc-phase")!;
  const earthDistEl = document.getElementById("mc-earth-dist")!;
  const moonDistEl = document.getElementById("mc-moon-dist")!;
  const dayEl = document.getElementById("mc-day")!;
  const orionDot = document.getElementById("mc-orion")!;
  const orionGlow = document.getElementById("mc-orion-glow")!;
  const completedPath = document.getElementById("mc-completed-path")!;

  // Trajectory SVG path for positioning Orion
  const trajPath = document.querySelector("#mc-trajectory path:first-of-type") as SVGPathElement;

  // Trajectory data for real distances
  let trajectoryData: TrajectoryData | null = null;
  loadTrajectory().then((d) => { trajectoryData = d; });

  // Mission timing
  const launchMs = MISSION.launchTime.getTime();
  const splashMs = MISSION.splashdownTime.getTime();
  const totalMs = splashMs - launchMs;

  function getProgress(): number {
    const now = Date.now();
    if (now <= launchMs) return 0;
    if (now >= splashMs) return 1;
    return (now - launchMs) / totalMs;
  }

  function formatDist(km: number): string {
    if (km >= 1_000) return `${(km / 1_000).toFixed(1)}K km`;
    return `${km.toFixed(0)} km`;
  }

  // Build completed sub-path
  function getSubPath(progress: number): string {
    if (!trajPath) return "";
    const totalLen = trajPath.getTotalLength();
    const len = totalLen * progress;
    const steps = Math.max(2, Math.ceil(progress * 80));
    const parts: string[] = [];
    for (let i = 0; i <= steps; i++) {
      const d = (i / steps) * len;
      const pt = trajPath.getPointAtLength(d);
      parts.push(i === 0 ? `M ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}` : `L ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`);
    }
    return parts.join(" ");
  }

  function update() {
    const met = getMissionElapsedTime();
    const phase = getMissionPhase(met);
    const progress = getProgress();
    const day = Math.floor(met / 86400) + 1;

    // MET
    metEl.textContent = formatMET(met);
    phaseEl.textContent = phase.label;
    phaseEl.style.color = phase.color;
    dayEl.textContent = String(day);

    // Distances (real if available, estimate otherwise)
    if (trajectoryData) {
      const dist = getDistancesAt(trajectoryData.spacecraft, trajectoryData.moon, new Date());
      earthDistEl.textContent = formatDist(dist.earth);
      moonDistEl.textContent = formatDist(dist.moon);
    } else {
      // Rough estimate
      const peak = 0.55;
      let earthKm: number;
      if (progress < peak) {
        earthKm = (progress / peak) * MISSION.maxEarthDistance;
      } else {
        earthKm = MISSION.maxEarthDistance * (1 - (progress - peak) / (1 - peak));
      }
      earthDistEl.textContent = formatDist(Math.max(0, earthKm));
      moonDistEl.textContent = formatDist(Math.max(0, 384_400 - earthKm));
    }

    // Position Orion on the SVG trajectory
    if (trajPath) {
      const totalLen = trajPath.getTotalLength();
      const pt = trajPath.getPointAtLength(totalLen * Math.min(progress, 0.999));
      orionDot.setAttribute("cx", String(pt.x));
      orionDot.setAttribute("cy", String(pt.y));
      orionGlow.setAttribute("cx", String(pt.x));
      orionGlow.setAttribute("cy", String(pt.y));

      // Completed path
      completedPath.setAttribute("d", getSubPath(progress));
    }
  }

  update();
  setInterval(update, 1000);
</script>
