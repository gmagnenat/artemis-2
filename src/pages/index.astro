---
import Layout from "../layouts/Layout.astro";
import MissionStatus from "../components/MissionStatus.astro";
import AstronautCard from "../components/AstronautCard.astro";
import TrajectoryScene from "../components/TrajectoryScene.astro";
import { CREW } from "../lib/astronauts";
---

<Layout>
  <!-- Hero -->
  <header class="relative min-h-screen flex flex-col items-center justify-center px-4 py-20">
    <!-- Subtle radial glow behind title -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-accent-blue/5 blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <p class="mono text-xs tracking-[0.3em] text-lunar-400 uppercase mb-4">NASA · Artemis Program · 2026</p>
      <h1 class="text-5xl sm:text-7xl font-bold tracking-tight leading-[1.1]">
        Artemis <span class="text-accent-blue">II</span>
      </h1>
      <p class="text-lg sm:text-xl text-lunar-300 mt-4 max-w-xl mx-auto leading-relaxed">
        Four astronauts. Ten days. Around the Moon and back.
        <br />
        <span class="text-lunar-400">The first crewed lunar mission in over 50 years.</span>
      </p>
    </div>

    <!-- Mission Status Bar -->
    <div class="relative z-10 w-full max-w-4xl mx-auto mt-12">
      <MissionStatus />
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-lunar-400 animate-bounce">
      <span class="text-xs uppercase tracking-widest">Crew</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M5 8l5 5 5-5" />
      </svg>
    </div>
  </header>

  <!-- Crew Section -->
  <section class="px-4 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="mono text-xs tracking-[0.3em] text-lunar-400 uppercase mb-2">The Crew of</p>
        <h2 class="text-3xl sm:text-4xl font-bold">
          Orion <span class="text-accent-gold">"Integrity"</span>
        </h2>
        <p class="text-lunar-400 mt-2 text-sm">Tap a card to see stats</p>
      </div>

      <div class="flex flex-wrap justify-center gap-8">
        {CREW.map((astronaut, i) => (
          <AstronautCard astronaut={astronaut} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- 3D Scene placeholder -->
  <section id="trajectory" class="px-4 py-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-8">
        <p class="mono text-xs tracking-[0.3em] text-lunar-400 uppercase mb-2">Mission Control</p>
        <h2 class="text-3xl sm:text-4xl font-bold">
          Live from <span class="text-accent-cyan">Orion</span>
        </h2>
      </div>
      <TrajectoryScene />
    </div>
  </section>

  <!-- Footer -->
  <footer class="px-4 py-12 text-center text-lunar-400 text-xs">
    <p>Data from NASA JPL Horizons · Images NASA Public Domain</p>
    <p class="mt-1">Built with Astro, Three.js, and too much coffee</p>
  </footer>
</Layout>
