---
/**
 * TrajectoryScene — SVG trajectory with live Orion position.
 * Uses a hand-crafted free-return trajectory shape matching the published
 * Artemis II profile, with Orion's position driven by mission elapsed time.
 */
---

<div id="trajectory-container" class="relative w-full">
  <svg
    id="trajectory-svg"
    viewBox="0 0 1000 520"
    class="w-full h-auto"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="earth-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.35" />
        <stop offset="50%" stop-color="#3b82f6" stop-opacity="0.08" />
        <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="moon-glow-g" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#94a3b8" stop-opacity="0.25" />
        <stop offset="50%" stop-color="#94a3b8" stop-opacity="0.05" />
        <stop offset="100%" stop-color="#94a3b8" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="orion-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9" />
        <stop offset="30%" stop-color="#f59e0b" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#f59e0b" stop-opacity="0" />
      </radialGradient>
      <!-- Trajectory gradient: blue near Earth, cyan outbound, gold at Moon, cyan return -->
      <linearGradient id="traj-grad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#3b82f6" />
        <stop offset="40%" stop-color="#06b6d4" />
        <stop offset="50%" stop-color="#f59e0b" />
        <stop offset="60%" stop-color="#06b6d4" />
        <stop offset="100%" stop-color="#3b82f6" />
      </linearGradient>
      <filter id="glow-filter">
        <feGaussianBlur stdDeviation="2" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- Stars -->
    <g id="stars" fill="white" opacity="0.3"></g>

    <!--
      Artemis II free-return trajectory (top-down schematic).
      The path goes: Earth → outbound coast (curving up) → behind the Moon
      (tight loop around far side) → return coast (curving down) → Earth.
      The outbound and return legs are separated vertically to show the
      figure-eight clearly. The lunar flyby loop wraps behind the Moon.
    -->

    <!-- Full trajectory path -->
    <path
      id="trajectory-path"
      d="M 140 260
         C 250 160, 450 100, 650 130
         C 750 145, 820 180, 850 230
         C 875 270, 875 290, 850 320
         C 820 370, 750 400, 650 390
         C 450 370, 250 340, 140 260"
      fill="none"
      stroke="url(#traj-grad)"
      stroke-width="1.5"
      opacity="0.5"
    />

    <!-- Brighter glow version of the path -->
    <path
      id="trajectory-glow"
      d="M 140 260
         C 250 160, 450 100, 650 130
         C 750 145, 820 180, 850 230
         C 875 270, 875 290, 850 320
         C 820 370, 750 400, 650 390
         C 450 370, 250 340, 140 260"
      fill="none"
      stroke="#06b6d4"
      stroke-width="4"
      opacity="0.07"
      filter="url(#glow-filter)"
    />

    <!-- Completed portion (drawn by JS) -->
    <path
      id="trajectory-completed"
      d=""
      fill="none"
      stroke="#06b6d4"
      stroke-width="2.5"
      opacity="0.6"
      stroke-linecap="round"
    />

    <!-- Earth -->
    <circle cx="140" cy="260" r="55" fill="url(#earth-glow)" />
    <circle cx="140" cy="260" r="18" fill="#0f2847" stroke="#3b82f6" stroke-width="1.5" />
    <!-- Earth surface hint -->
    <circle cx="140" cy="260" r="18" fill="none" stroke="#1e5a9e" stroke-width="0.5" stroke-dasharray="3 5" opacity="0.4" />
    <text x="140" y="295" text-anchor="middle" fill="#64748b" font-size="13" font-family="'Space Grotesk', sans-serif">Earth</text>

    <!-- Moon -->
    <circle cx="830" cy="275" r="35" fill="url(#moon-glow-g)" />
    <circle cx="830" cy="275" r="8" fill="#3a3a40" stroke="#94a3b8" stroke-width="1" />
    <text x="830" y="300" text-anchor="middle" fill="#64748b" font-size="13" font-family="'Space Grotesk', sans-serif">Moon</text>

    <!-- Distance line Earth → Orion (dashed) -->
    <line id="dist-line" x1="140" y1="260" x2="140" y2="260" stroke="#3b82f6" stroke-width="0.5" stroke-dasharray="4 4" opacity="0.15" />

    <!-- Orion -->
    <circle id="orion-halo" cx="140" cy="260" r="20" fill="url(#orion-glow)" />
    <circle id="orion-pulse" cx="140" cy="260" r="8" fill="#f59e0b" opacity="0.12">
      <animate attributeName="r" values="8;15;8" dur="2.5s" repeatCount="indefinite" />
      <animate attributeName="opacity" values="0.12;0;0.12" dur="2.5s" repeatCount="indefinite" />
    </circle>
    <circle id="orion-dot" cx="140" cy="260" r="4.5" fill="#f59e0b" />
    <text id="orion-label" x="140" y="245" text-anchor="middle" fill="#f59e0b" font-size="10" font-family="'JetBrains Mono', monospace" opacity="0.9">ORION</text>

    <!-- Mission phase markers along the path -->
    <g id="phase-markers" fill="none" opacity="0.4">
      <!-- TLI marker -->
      <circle cx="220" cy="205" r="2" fill="#f59e0b" opacity="0.5" />
      <text x="220" y="195" text-anchor="middle" fill="#64748b" font-size="8" font-family="'JetBrains Mono', monospace">TLI</text>

      <!-- Closest approach marker -->
      <circle cx="862" cy="275" r="2" fill="#f59e0b" opacity="0.5" />
      <text x="895" y="270" text-anchor="middle" fill="#64748b" font-size="8" font-family="'JetBrains Mono', monospace">FLYBY</text>
    </g>

    <!-- Distance readout -->
    <text id="dist-text" x="140" y="475" text-anchor="start" fill="#3b82f6" font-size="11" font-family="'JetBrains Mono', monospace" opacity="0.6"></text>
  </svg>
</div>

<script>
  import { MISSION } from "@/lib/mission";

  // -----------------------------------------------------------------------
  // Get the SVG path element and compute points along it for positioning
  // -----------------------------------------------------------------------

  const pathEl = document.getElementById("trajectory-path") as unknown as SVGPathElement;
  const completedEl = document.getElementById("trajectory-completed") as unknown as SVGPathElement;
  const orionDot = document.getElementById("orion-dot") as SVGCircleElement;
  const orionHalo = document.getElementById("orion-halo") as SVGCircleElement;
  const orionPulse = document.getElementById("orion-pulse") as SVGCircleElement;
  const orionLabel = document.getElementById("orion-label") as SVGTextElement;
  const distLine = document.getElementById("dist-line") as SVGLineElement;
  const distText = document.getElementById("dist-text") as SVGTextElement;
  const starsG = document.getElementById("stars") as SVGGElement;

  const EARTH_X = 140;
  const EARTH_Y = 260;

  // Generate stars
  for (let i = 0; i < 60; i++) {
    const star = document.createElementNS("http://www.w3.org/2000/svg", "circle");
    star.setAttribute("cx", String(Math.random() * 1000));
    star.setAttribute("cy", String(Math.random() * 520));
    star.setAttribute("r", String(0.3 + Math.random() * 1.1));
    starsG.appendChild(star);
  }

  // -----------------------------------------------------------------------
  // Mission progress: MET → fraction [0, 1] along the path
  // -----------------------------------------------------------------------

  const launchMs = MISSION.launchTime.getTime();
  const splashMs = MISSION.splashdownTime.getTime();
  const totalMs = splashMs - launchMs;

  // The trajectory starts ~3.4h after launch (ICPS separation) and the
  // first visible path point is after TLI (~25h). We map MET to path
  // progress with a slight non-linearity: the outbound coast is slower
  // visually than the fast flyby.

  function getProgress(): number {
    const now = Date.now();
    if (now <= launchMs) return 0;
    if (now >= splashMs) return 1;
    return (now - launchMs) / totalMs;
  }

  // -----------------------------------------------------------------------
  // Approximate distance from Earth (km) based on progress.
  // Uses known mission milestones for interpolation.
  // -----------------------------------------------------------------------

  // progress → distance from Earth in km (approximate)
  const distMilestones: [number, number][] = [
    [0.00, 185],         // LEO
    [0.05, 2_200],       // Perigee raise
    [0.10, 70_000],      // After apogee raise
    [0.15, 50_000],      // Before TLI
    [0.20, 100_000],     // Early outbound
    [0.30, 200_000],     // Mid outbound
    [0.40, 300_000],     // Late outbound
    [0.50, 380_000],     // Approaching Moon
    [0.55, 413_146],     // Max Earth distance / closest Moon
    [0.60, 390_000],     // Departing Moon
    [0.70, 300_000],     // Mid return
    [0.80, 200_000],     // Late return
    [0.90, 100_000],     // Approach Earth
    [0.95, 30_000],      // Reentry corridor
    [1.00, 0],           // Splashdown
  ];

  function getDistanceKm(progress: number): number {
    for (let i = 0; i < distMilestones.length - 1; i++) {
      const [p0, d0] = distMilestones[i];
      const [p1, d1] = distMilestones[i + 1];
      if (progress >= p0 && progress <= p1) {
        const t = (progress - p0) / (p1 - p0);
        return d0 + t * (d1 - d0);
      }
    }
    return 0;
  }

  function formatDist(km: number): string {
    if (km >= 1_000) return `${(km / 1_000).toFixed(1)}K km from Earth`;
    return `${km.toFixed(0)} km from Earth`;
  }

  // -----------------------------------------------------------------------
  // Build the completed path segment (from start to current progress)
  // -----------------------------------------------------------------------

  function getSubPath(progress: number): string {
    const totalLen = pathEl.getTotalLength();
    const len = totalLen * progress;

    // Sample points along the path up to current progress
    const steps = Math.max(2, Math.ceil(progress * 100));
    const points: string[] = [];
    for (let i = 0; i <= steps; i++) {
      const d = (i / steps) * len;
      const pt = pathEl.getPointAtLength(d);
      points.push(i === 0 ? `M ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}` : `L ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`);
    }
    return points.join(" ");
  }

  // -----------------------------------------------------------------------
  // Update loop
  // -----------------------------------------------------------------------

  function update() {
    const progress = getProgress();
    const totalLen = pathEl.getTotalLength();
    const pt = pathEl.getPointAtLength(totalLen * Math.min(progress, 0.999));

    // Orion position
    orionDot.setAttribute("cx", String(pt.x));
    orionDot.setAttribute("cy", String(pt.y));
    orionHalo.setAttribute("cx", String(pt.x));
    orionHalo.setAttribute("cy", String(pt.y));
    orionPulse.setAttribute("cx", String(pt.x));
    orionPulse.setAttribute("cy", String(pt.y));
    orionLabel.setAttribute("x", String(pt.x));
    orionLabel.setAttribute("y", String(pt.y - 15));

    // Distance line
    distLine.setAttribute("x2", String(pt.x));
    distLine.setAttribute("y2", String(pt.y));

    // Completed path
    completedEl.setAttribute("d", getSubPath(progress));

    // Distance readout
    const km = getDistanceKm(progress);
    distText.textContent = formatDist(km);
  }

  update();
  setInterval(update, 1000);
</script>
