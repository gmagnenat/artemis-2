---
/**
 * TrajectoryScene — Live trajectory tracker with Orion position.
 * Simple clean SVG ellipse with Moon bump + live telemetry.
 */
---

<div class="space-y-6">
  <!-- Live trajectory SVG -->
  <div class="glass rounded-xl p-5 sm:p-8">
    <svg
      id="mc-trajectory"
      viewBox="0 0 700 200"
      class="w-full h-auto"
      role="img"
      aria-label="Live Artemis II trajectory showing Orion's current position between Earth and Moon"
    >
      <title>Artemis II Live Trajectory</title>

      <!-- Full trajectory path: ellipse with a bump wrapping behind the Moon -->
      <path
        id="mc-traj-path"
        d="M 80 100
           C 250 25, 500 15, 610 60
           C 650 75, 670 90, 670 100
           C 670 110, 650 125, 610 140
           C 500 185, 250 175, 80 100"
        fill="none"
        stroke="#06b6d4"
        stroke-width="1"
        opacity="0.2"
      />

      <!-- Completed portion -->
      <path
        id="mc-completed"
        d=""
        fill="none"
        stroke="#06b6d4"
        stroke-width="2.5"
        opacity="0.5"
        stroke-linecap="round"
      />

      <!-- Earth -->
      <circle cx="80" cy="100" r="35" fill="#3b82f6" opacity="0.04" />
      <circle cx="80" cy="100" r="12" fill="#0f2847" stroke="#3b82f6" stroke-width="1.2" />
      <text x="80" y="126" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="'Neue Montreal Mono', monospace" opacity="0.6">EARTH</text>

      <!-- Moon -->
      <circle cx="630" cy="100" r="22" fill="#94a3b8" opacity="0.03" />
      <circle cx="630" cy="100" r="5.5" fill="#3a3a40" stroke="#94a3b8" stroke-width="0.8" />
      <text x="630" y="120" text-anchor="middle" fill="#94a3b8" font-size="10" font-family="'Neue Montreal Mono', monospace" opacity="0.6">MOON</text>

      <!-- Distance line Earth → Orion -->
      <line id="mc-dist-line" x1="80" y1="100" x2="80" y2="100" stroke="#3b82f6" stroke-width="0.4" stroke-dasharray="3 3" opacity="0.12" />

      <!-- Orion -->
      <circle id="mc-orion-glow" cx="80" cy="100" r="12" fill="#f59e0b" opacity="0.1">
        <animate attributeName="r" values="12;20;12" dur="2.5s" repeatCount="indefinite" />
        <animate attributeName="opacity" values="0.1;0;0.1" dur="2.5s" repeatCount="indefinite" />
      </circle>
      <circle id="mc-orion" cx="80" cy="100" r="4" fill="#f59e0b" />
      <text id="mc-orion-label" x="80" y="85" text-anchor="middle" fill="#f59e0b" font-size="9" font-family="'Neue Montreal Mono', monospace" opacity="0.8">ORION</text>
    </svg>
  </div>

  <!-- Telemetry panel -->
  <div class="glass rounded-xl p-5 sm:p-6">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div class="mc-tel">
        <span class="mc-label">Mission Elapsed Time</span>
        <span id="mc-met" class="mc-value mono">--:--:--:--</span>
      </div>
      <div class="mc-tel">
        <span class="mc-label">Current Phase</span>
        <span id="mc-phase" class="mc-value font-heading font-extrabold text-accent-gold">---</span>
      </div>
      <div class="mc-tel">
        <span class="mc-label">Earth Distance</span>
        <span id="mc-earth-dist" class="mc-value mono">--- km</span>
      </div>
      <div class="mc-tel">
        <span class="mc-label">Moon Distance</span>
        <span id="mc-moon-dist" class="mc-value mono">--- km</span>
      </div>
    </div>
  </div>
</div>

<style>
  .mc-tel {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mc-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-lunar-300);
    font-family: var(--font-mono);
  }
  .mc-value {
    font-size: 20px;
    font-weight: 500;
    color: var(--color-lunar-100);
  }
  @media (max-width: 640px) {
    .mc-value { font-size: 15px; }
  }
</style>

<script>
  import { getMissionElapsedTime, getMissionPhase, formatMET, MISSION } from "../lib/mission";
  import { loadTrajectory, getDistancesAt, type TrajectoryData } from "../lib/trajectory";

  const metEl = document.getElementById("mc-met")!;
  const phaseEl = document.getElementById("mc-phase")!;
  const earthDistEl = document.getElementById("mc-earth-dist")!;
  const moonDistEl = document.getElementById("mc-moon-dist")!;
  const orionDot = document.getElementById("mc-orion")!;
  const orionGlow = document.getElementById("mc-orion-glow")!;
  const orionLabel = document.getElementById("mc-orion-label")!;
  const completedPath = document.getElementById("mc-completed")!;
  const distLine = document.getElementById("mc-dist-line")!;
  const trajPath = document.getElementById("mc-traj-path") as unknown as SVGPathElement;

  let trajectoryData: TrajectoryData | null = null;
  loadTrajectory().then((d) => { trajectoryData = d; });

  const launchMs = MISSION.launchTime.getTime();
  const splashMs = MISSION.splashdownTime.getTime();
  const totalMs = splashMs - launchMs;

  function getProgress(): number {
    const now = Date.now();
    if (now <= launchMs) return 0;
    if (now >= splashMs) return 1;
    const timeProgress = (now - launchMs) / totalMs;

    // Remap time progress to path progress.
    // The Moon flyby is at ~55% of mission time but ~50% of path length.
    // Outbound is slower (coasting), return is faster.
    // Use piecewise linear mapping: time → path
    const map: [number, number][] = [
      [0, 0],        // launch
      [0.10, 0.05],  // early orbit maneuvers (slow, near Earth)
      [0.15, 0.10],  // TLI burn
      [0.35, 0.30],  // mid outbound coast
      [0.50, 0.45],  // approaching Moon
      [0.55, 0.50],  // closest approach = midpoint of path
      [0.60, 0.55],  // departing Moon
      [0.75, 0.70],  // mid return coast
      [0.90, 0.88],  // approaching Earth
      [1, 1],        // splashdown
    ];

    for (let i = 0; i < map.length - 1; i++) {
      const [t0, p0] = map[i];
      const [t1, p1] = map[i + 1];
      if (timeProgress >= t0 && timeProgress <= t1) {
        const t = (timeProgress - t0) / (t1 - t0);
        return p0 + t * (p1 - p0);
      }
    }
    return timeProgress;
  }

  function formatDist(km: number): string {
    if (km >= 1_000) return `${(km / 1_000).toFixed(1)}K km`;
    return `${km.toFixed(0)} km`;
  }

  function getSubPath(progress: number): string {
    if (!trajPath) return "";
    const totalLen = trajPath.getTotalLength();
    const len = totalLen * progress;
    const steps = Math.max(2, Math.ceil(progress * 100));
    const parts: string[] = [];
    for (let i = 0; i <= steps; i++) {
      const d = (i / steps) * len;
      const pt = trajPath.getPointAtLength(d);
      parts.push(i === 0 ? `M ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}` : `L ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`);
    }
    return parts.join(" ");
  }

  function update() {
    const met = getMissionElapsedTime();
    const phase = getMissionPhase(met);
    const progress = getProgress();

    metEl.textContent = formatMET(met);
    phaseEl.textContent = phase.label;
    phaseEl.style.color = phase.color;

    // Distances — only show when real data is available
    if (trajectoryData) {
      const dist = getDistancesAt(trajectoryData.spacecraft, trajectoryData.moon, new Date());
      earthDistEl.textContent = formatDist(dist.earth);
      moonDistEl.textContent = formatDist(dist.moon);
    }

    // Orion position on path
    if (trajPath) {
      const totalLen = trajPath.getTotalLength();
      const pt = trajPath.getPointAtLength(totalLen * Math.min(progress, 0.999));
      orionDot.setAttribute("cx", String(pt.x));
      orionDot.setAttribute("cy", String(pt.y));
      orionGlow.setAttribute("cx", String(pt.x));
      orionGlow.setAttribute("cy", String(pt.y));
      orionLabel.setAttribute("x", String(pt.x));
      orionLabel.setAttribute("y", String(pt.y - 14));
      distLine.setAttribute("x2", String(pt.x));
      distLine.setAttribute("y2", String(pt.y));
      completedPath.setAttribute("d", getSubPath(progress));
    }
  }

  update();
  setInterval(update, 1000);
</script>
